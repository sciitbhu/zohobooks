# =============================================================================
# ZOHO BOOKS OAUTH 2.0 CREDENTIALS
# Generate these at: https://api-console.zoho.com  (Server-based Application)
# Scopes needed: ZohoBooks.fullaccess.all  (or narrower: invoices, contacts,
# reports, expenses, bills, items, chartofaccounts — see Zoho docs)
# =============================================================================
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
# One-time "grant token" exchanged for the long-lived refresh token.
# See README.md "Zoho OAuth bootstrap" section for the one-time script to run.
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_ORGANIZATION_ID=your_zoho_books_org_id_here

# Zoho data center domain — pick the one matching your account region.
# US: www.zohoapis.com        | accounts: accounts.zoho.com
# EU: www.zohoapis.eu         | accounts: accounts.zoho.eu
# IN: www.zohoapis.in         | accounts: accounts.zoho.in
# AU: www.zohoapis.com.au     | accounts: accounts.zoho.com.au
ZOHO_API_DOMAIN=www.zohoapis.in
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in

# Custom Field placed on the Invoice module in Zoho Books, used to store
# the AI-assigned category (create this once in Zoho Books Settings ->
# Customization -> Invoices -> Custom Fields, type = "Dropdown" or "Text").
ZOHO_INVOICE_CUSTOM_FIELD_API_NAME=cf_income_category

# Shared secret you configure on the Zoho Books "Webhook" setup screen and
# send back as a header/query param so /webhook/zoho/invoice can verify the
# request actually came from Zoho and not a random caller.
ZOHO_WEBHOOK_SHARED_SECRET=choose_a_long_random_string

# =============================================================================
# ANTHROPIC (CLAUDE) API
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Kept as a variable, not hardcoded, so it is trivial to upgrade later.
CLAUDE_MODEL=claude-sonnet-5

# =============================================================================
# LOCAL FILE / REPORTING PATHS
# =============================================================================
MIS_REPORT_ROOT=~/Documents/Zoho_MIS_Reports

# =============================================================================
# APP / SERVER
# =============================================================================
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787
LOG_LEVEL=INFO
